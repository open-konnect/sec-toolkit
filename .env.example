# Public production origin used for canonical URLs, Open Graph URLs, and sitemap.xml.
# Use the custom domain, not a temporary *.pages.dev hostname.
VITE_SITE_URL=https://securitytoolkit.dev

# Optional social sharing image (absolute URL or root-relative path).
VITE_OG_IMAGE=/og-image.png

# Optional Twitter/X handle, including the leading @.
# VITE_TWITTER_HANDLE=@yourhandle

# Google Search Console HTML-tag verification value (content="..." only).
# VITE_GOOGLE_SITE_VERIFICATION=

# Set to true ONLY for preview/staging builds. This emits noindex meta tags,
# a disallow-all robots.txt, and an X-Robots-Tag header. Never set it in production.
# VITE_NOINDEX=true
