{
  "name": "developer-security-toolkit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && npm run fetch:llm-models && vite build && npm run build:ssr && node scripts/generate-seo.mjs",
    "build:ssr": "vite build --config vite.ssr.config.ts",
    "fetch:llm-models": "node scripts/fetch-llm-models.mjs",
    "preview": "npm run build && wrangler dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.1",
    "vitest": "^5.0.5",
    "wrangler": "^4.153.0"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.7"
  }
}
